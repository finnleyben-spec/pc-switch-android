<?xml version="1.0" encoding="utf-8"?>
<!-- v3.0 (Public Release): keine personalen Certs/Domains mehr.
     HA muss über HTTPS erreichbar sein (Domain, Tailscale-Host oder
     eigene CA, die in den Systemeinstellungen des Geräts installiert ist). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
